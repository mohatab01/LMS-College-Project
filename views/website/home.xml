<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="footer_copyright_company_name" inherit_id="website.layout">
        <xpath expr="//footer" position="replace">
            <div class="row pt16 pb16" style="background-color: #14a199;">
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                </div>
                <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                    <div class="row">
                        <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4 center-custom d-flex align-items-center justify-content-center">
                            <span class="o_footer_copyright_name mr-" style="color: white;">LMS &amp;copy; 2022 All
                                Rights Reserved
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                </div>
            </div>
        </xpath>
    </template>

    <template id="website.footer_language_selector_flag" name="Footer Language Selector Flag"
              inherit_id="portal.footer_language_selector" active="True">
        <xpath expr="//t[@id='language_selector_call']" position="replace">
        </xpath>
    </template>

    <template id="lms_option_header_brand_logo" inherit_id="website.placeholder_header_brand" name="Header Brand Logo" active="True">
        <xpath expr="." position="replace">
            <a href="/" t-attf-class="navbar-brand logo #{_link_class}">
                <span style="background-image: url('/lms/static/src/svg/logo.svg');" t-field="website.logo" t-options="{'widget': 'image'}" role="img" t-att-aria-label="'Logo of %s' % website.name" t-att-title="website.name"/>
            </a>
        </xpath>
    </template>

    <template id="home" name="Home">
        <!-- Required meta tags -->
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous"/>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
        <link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/album/"/>

        <t t-call="website.layout">

            <div class="px-4 py-5 text-center">
                <h1 class="display-5 fw-bold text-body-emphasis">Library Management System</h1>
                <div class="col-lg-6 mx-auto">
                  <p class="lead mb-4">A library management system is software that is designed to manage all the functions of a library. It helps librarian to maintain the database of new books and the books that are borrowed by students along with their due dates.</p>
                </div>
            </div>

            <div class="container pb-5">
                <div class="row">
                  <div class="col">
                    <div class="input-group">
                      <input id="input-search" type="text" class="form-control" t-attf-value="#{search}" placeholder="Book name" aria-label="Book name" aria-describedby="button-search"/>
                      <button class="btn btn-outline-secondary" onClick="returnSearchResult()" type="button" id="button-search">Search</button>
                    </div>
                  </div>
                  <div class="col">
                    <select id="select-category" class="form-select" aria-label="Default select example" onChange="returnToCategory(this.value)">
                      <option value="0" hidden="">Select Category</option>
                        <t t-foreach="categories" t-as="category">
                            <option t-if="category.id == category_id" t-attf-id="#{category.id}" t-attf-value="#{category.id}" selected="1">
                                <t t-esc="category.name"/>
                            </option>
                            <option t-if="category.id != category_id" t-attf-id="#{category.id}" t-attf-value="#{category.id}">
                                <t t-esc="category.name"/>
                            </option>
                        </t>
                    </select>
                  </div>
                </div>
            </div>

            <div class="album py-5">
                <div class="container">
                    <t t-if="books_count > 0">
                      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
                          <t t-foreach="books" t-as="book">
                              <div class="col-4">
                                  <div class="card shadow-sm">
                                      <div style="position: relative;text-align: center;color: white;">
                                          <img class="card-img-top" t-attf-src="data:image/*;base64,{{book['thumbnail']}}"
                                                 style="height: 400px;width:100%;object-fit: fill;"/>
                                          <t t-if="book['is_borrowed']">
                                              <span style="position: absolute;top: 8px;right: 8px;" class="badge bg-warning text-dark">Not available</span>
                                          </t>
                                          <t t-else="">
                                              <span style="position: absolute;top: 8px;right: 8px;" class="badge bg-success">Available</span>
                                          </t>
                                      </div>
                                      <div class="card-body">
                                          <p class="card-text">
                                              <t t-esc="book['title']" style="font-size: 12px;font-weight: bold;"/>
                                              <t t-if="book['edition']">
                                                  <span style="font-size: 12px;">| <t t-esc="book['edition']"/> Edition</span>
                                              </t>
                                          </p>
                                          <p>
                                              <span style="font-size: 12px;">by <t t-esc="book['auther_name']"/></span>
                                          </p>
                                          <span class="badge bg-primary"><t t-esc="book['category']"/></span>
                                    </div>
                                  </div>
                              </div>
                          </t>
                      </div>
                    </t>
                      <t t-else="">
                          <div class="row">
                              <div class="text-center">
                                <h5 class="display-6 fw-bold text-body-emphasis">No available books</h5>
                              </div>
                          </div>
                      </t>
                </div>
            </div>

        </t>

        <script>
            function returnToCategory(category_id) {
                console.log("here");
                console.log(category_id);
                $.ajax({
                    type: "GET",
                    url: "/category/" + category_id,
                    data:{},
                    success: function(response) {
                        window.location.href = "/category/" + category_id;
                        }
                });
            }

            function returnSearchResult() {
                var input = document.getElementById("input-search").value;
                var category_id = document.getElementById("select-category").value;
                if(input.length == 0){
                    $.ajax({
                        type: "GET",
                        url: "/",
                        data:{},
                        success: function(response) {
                            if (category_id == 0){
                                window.location.href = "/";
                            }else {
                                window.location.href = "/category/" + category_id;
                            }
                        }
                    });
                }
                else if(input.length > 2){
                    $.ajax({
                        type: "GET",
                        url: "/",
                        data:{search: input},
                        success: function(response) {
                            if (category_id == 0){
                                window.location.href = "/?search=" + input;
                            }else {
                                window.location.href = "/category/" + category_id + "/?search=" + input;
                            }
                        }
                    });
                }
            }
        </script>

    </template>

</odoo>
