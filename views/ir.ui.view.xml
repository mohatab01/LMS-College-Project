<?xml version="1.0"?>
<odoo>
    <data>
        <!-- Actions -->
        <record id="action_book" model="ir.actions.act_window">
          <field name="name">Books</field>
          <field name="type">ir.actions.act_window</field>
          <field name="res_model">book</field>
          <field name="view_mode">tree,form</field>
        </record>

        <record id="action_category" model="ir.actions.act_window">
          <field name="name">Categories</field>
          <field name="type">ir.actions.act_window</field>
          <field name="res_model">category</field>
          <field name="view_mode">tree,form</field>
        </record>

        <record id="action_borrow" model="ir.actions.act_window">
          <field name="name">Borrows</field>
          <field name="type">ir.actions.act_window</field>
          <field name="res_model">borrows</field>
          <field name="view_mode">tree,form</field>
        </record>

        <record id="action_student" model="ir.actions.act_window">
          <field name="name">Students</field>
          <field name="type">ir.actions.act_window</field>
          <field name="res_model">student</field>
          <field name="view_mode">tree,form</field>
        </record>

        <!-- Lists -->
        <record id="view_book_list" model="ir.ui.view">
          <field name="name">View book list</field>
          <field name="model">book</field>
          <field name="arch" type="xml">
            <tree>
              <field name="isbn"/>
              <field name="category_id"/>
              <field name="title"/>
              <field name="edition"/>
              <field name="location"/>
              <field name="auther_name"/>
              <field name="is_borrowed"/>
            </tree>
          </field>
        </record>

        <record id="view_borrow_list" model="ir.ui.view">
          <field name="name">View borrow list</field>
          <field name="model">borrows</field>
          <field name="arch" type="xml">
            <tree>
              <field name="book_id"/>
              <field name="student_id"/>
              <field name="user_id"/>
              <field name="borrow_date"/>
              <field name="return_date"/>
              <field name="is_returned"/>
            </tree>
          </field>
        </record>

        <record id="view_category_list" model="ir.ui.view">
          <field name="name">View category list</field>
          <field name="model">category</field>
          <field name="arch" type="xml">
            <tree>
              <field name="name"/>
              <field name="active"/>
            </tree>
          </field>
        </record>

        <record id="view_student_list" model="ir.ui.view">
          <field name="name">View student list</field>
          <field name="model">student</field>
          <field name="arch" type="xml">
            <tree>
              <field name="name"/>
              <field name="id_number"/>
              <field name="phone"/>
              <field name="email"/>
            </tree>
          </field>
        </record>

        <!-- Forms -->
        <record id="view_book_form" model="ir.ui.view">
          <field name="name">View book form</field>
          <field name="model">book</field>
          <field name="arch" type="xml">
            <form>
              <sheet>
                  <div class="oe_title">
                    <h1>
                      <field name="title" placeholder="Title"/>
                    </h1>
                  </div>
                <group name="main_group">
                    <group name="group_left">
                        <field name="isbn"/>
                        <field name="edition"/>
                        <field name="location"/>
                        <field name="auther_name"/>
                        <field name="category_id"/>
                        <field name="is_borrowed"/>
                    </group>
                    <group name="group_left">
                        <field name="thumbnail" widget="image"/>
                    </group>
                    <notebook name="main_notebook">
                      <page name="description" string="Description">
                        <field name="description"/>
                      </page>
                    </notebook>
                </group>
              </sheet>
            </form>
          </field>
        </record>

        <record id="view_borrow_form" model="ir.ui.view">
          <field name="name">View borrow form</field>
          <field name="model">borrows</field>
          <field name="arch" type="xml">
            <form>
                <header>
                    <button name="return_book" string="Return Book" type="object" calss="oe_highlight"
                            attrs="{'invisible': ['|',('is_returned', '=', True),('id', '=', False)]}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                          <field name="book_id" placeholder="Book"/>
                        </h1>
                    </div>
                    <group name="main_group">
                        <group name="group_left">
                            <field name="student_id"/>
                            <field name="user_id"/>
                            <field name="borrow_date"/>
                            <field name="return_date"/>
                            <field name="is_returned"/>
                        </group>
                    </group>
                </sheet>
            </form>
          </field>
        </record>

        <record id="view_category_form" model="ir.ui.view">
          <field name="name">View category form</field>
          <field name="model">category</field>
          <field name="arch" type="xml">
            <form>
              <sheet>
                <group name="main_group">
                    <group name="group_left">
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </group>
              </sheet>
            </form>
          </field>
        </record>

        <record id="view_student_form" model="ir.ui.view">
          <field name="name">View student form</field>
          <field name="model">student</field>
          <field name="arch" type="xml">
            <form>
              <sheet>
                <group name="main_group">
                    <group name="group_left">
                        <field name="name"/>
                        <field name="id_number"/>
                        <field name="phone"/>
                        <field name="email"/>
                    </group>
                </group>
              </sheet>
            </form>
          </field>
        </record>

    </data>
</odoo>
